# Production settings. On the server: /opt/callcenter/.env, owner deploy, chmod 600. Never commit the real file.
# Check before deploying: /opt/callcenter/bin/check-env.sh   Runbook: docs/rewrite/DEPLOY.md
# Generate secrets with: openssl rand -hex 32

# --- PostgreSQL (container "postgres", not published to the host) ---
# Letters, digits and . _ ~ - only: it is embedded into DATABASE_URL. Used when the volume is first
# created; changing it later also needs ALTER ROLE (see DEPLOY.md, "Ротация секретов").
POSTGRES_PASSWORD=
# POSTGRES_USER=callcenter
# POSTGRES_DB=callcenter

# --- Images. IMAGE_TAG is rewritten by infra/server/deploy.sh on every deploy (full commit SHA). ---
REGISTRY=ghcr.io/nuriddin2468
IMAGE_TAG=local

# --- Web / TLS (Caddy in the "web" container) ---
# Production: the public domain (keep the legacy WEBAUTHN_RP_ID domain so passkeys keep working).
# Caddy obtains a Let's Encrypt certificate itself; with only TCP 443 forwarded by Kerio it uses the
# TLS-ALPN challenge (HTTP_PORT=80 and HTTPS_PORT=443 on the VM). ":80" = plain HTTP behind another
# TLS proxy; a LAN IP = Caddy's internal CA (browser warning, no passkeys).
SITE_ADDRESS=:80
# Host ports. May include a bind address, e.g. 192.0.2.10:8080. Docker-published ports bypass ufw.
HTTP_PORT=8080
HTTPS_PORT=8443
TRUSTED_PROXIES=172.16.0.0/12

# --- Deploy script only (ignored by the app) ---
# After a deploy, deploy.sh also checks /api/health THROUGH Caddy (derived from SITE_ADDRESS and the
# ports). off = check only the api container; DEPLOY_EDGE_URL = use this URL instead.
# DEPLOY_EDGE_CHECK=auto
# DEPLOY_EDGE_URL=
# DEPLOY_HEALTH_TIMEOUT=180

# --- Passed to the api container (all keys: apps/api/.env.example, apps/api/src/config/env.schema.ts) ---
LOG_LEVEL=info
COOKIE_SECURE=true
SESSION_TTL_HOURS=72
BOOTSTRAP_SUPERUSER_USERNAME=superuser
# First start only: creates the superuser when none exists (min 12 chars). Remove it after the
# first login. An empty value is treated as unset.
# BOOTSTRAP_SUPERUSER_PASSWORD=

# PBX MariaDB: dedicated read-only user (SELECT on asteriskcdrdb.cdr and asterisk.users), never root.
PBX_DB_HOST=
PBX_DB_PORT=3306
PBX_DB_USER=
PBX_DB_PASSWORD=
PBX_DB_NAME=asteriskcdrdb

# Asterisk AMI: dedicated user from manager_custom.conf with permit= limited to this server.
AMI_HOST=
AMI_PORT=5038
AMI_USER=
AMI_PASSWORD=

# Recordings: chrooted read-only SFTP user with key auth. Inside the chroot the folder is /monitor.
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PRIVATE_KEY_PATH=
SFTP_MONITOR_PATH=/var/spool/asterisk/monitor
