# Installed by infra/server/bootstrap.sh into /etc/systemd/system/.
# Run by callcenter-backup.timer. Manual run: sudo systemctl start callcenter-backup.service
# Status/logs:  systemctl status callcenter-backup.service ; journalctl -u callcenter-backup.service
# Change retention without editing this file: sudo systemctl edit callcenter-backup.service
#   [Service]
#   Environment=KEEP_DAILY=30
[Unit]
Description=Call center PostgreSQL backup (pg_dump)
Documentation=https://github.com/nuriddin2468/call-center/blob/main/docs/rewrite/DEPLOY.md
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=APP_DIR=/opt/callcenter
Environment=KEEP_DAILY=14
Environment=KEEP_WEEKLY=8
Environment=KEEP_PRE_DEPLOY=10
Environment=WEEKLY_DOW=7
ExecStart=/opt/callcenter/bin/backup.sh --auto
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
