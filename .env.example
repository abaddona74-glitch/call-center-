# ====================================================
# CALL CENTER AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Nusxa oling va nomini .env deb o'zgartiring
# ====================================================

PORT=3535

# Issabel AMI Configuration (Asterisk Manager)
AMI_HOST=192.168.0.124
AMI_PORT=5038
AMI_USER=nodeuser
AMI_PASSWORD=your_ami_password_here

# Issabel SSH/SFTP Configuration (Audio yozuvlar va CDR DB)
SSH_HOST=192.168.0.124
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=your_ssh_password_here

SFTP_HOST=192.168.0.124
SFTP_PORT=22
SFTP_USER=root
SFTP_PASSWORD=your_sftp_password_here
SFTP_MONITOR_PATH=/var/spool/asterisk/monitor

# Redis Cache Configuration
REDIS_HOST=192.168.0.124
REDIS_PORT=6379

# Google Gemini AI Key (Ovoz tahlili va semantik tahlil)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Service (SMTP - Bildirishnomalar va xavfsizlik)
SMTP_USER=support@uniconsoft.uz
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Call Center Security" <support@uniconsoft.uz>

# Resend API Fallback
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Call Center Security <onboarding@resend.dev>
ADMIN_EMAIL=admin@uniconsoft.uz

# Deployment Configuration (Ishlab turgan server)
DEPLOY_HOST=213.230.110.9
DEPLOY_PORT=22
DEPLOY_USER=root
DEPLOY_PASS=your_deploy_password_here

# Telegram Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Blacklist Management
BLACKLIST_ADMIN_PASSWORD=your_secure_blacklist_admin_password

# WebAuthn / Passkeys Configuration (Biometrik kirish)
WEBAUTHN_RP_ID=uniconsoft.ddns.net
WEBAUTHN_RP_NAME=Call Center AI
WEBAUTHN_ORIGINS=https://uniconsoft.ddns.net,https://uniconsoft.ddns.net:3005,https://uniconsoft.ddns.net:3535
