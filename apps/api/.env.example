# Copy to .env.local for local development (pnpm dev:infra starts postgres + mock PBX db).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://callcenter:callcenter@127.0.0.1:54320/callcenter
DB_MIGRATE_ON_START=true

# Local dev runs over plain http
COOKIE_SECURE=false
SESSION_TTL_HOURS=72
TRUSTED_PROXIES=

# First start only: creates the superuser if none exists (min 12 chars)
BOOTSTRAP_SUPERUSER_USERNAME=superuser
BOOTSTRAP_SUPERUSER_PASSWORD=

# Passkeys (WebAuthn). Production must keep the legacy RP ID or existing passkeys break.
# Dev: WEBAUTHN_RP_ID=localhost, WEBAUTHN_ORIGINS=http://localhost:5173
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Call Center
WEBAUTHN_ORIGINS=http://localhost:5173

# Mail for password reset / email verification codes. Empty SMTP_HOST = no mail
# (with NODE_ENV=development the message is printed to the console instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Call Center <no-reply@localhost>

# PBX MariaDB — read-only user (mock from infra/compose.dev.yml)
PBX_DB_HOST=127.0.0.1
PBX_DB_PORT=33060
PBX_DB_USER=cc_readonly
PBX_DB_PASSWORD=cc_readonly_dev
PBX_DB_NAME=asteriskcdrdb

# Asterisk AMI (dev: AMI simulator — node infra/dev-pbx/ami-sim/ami-sim.mjs, 127.0.0.1:15038)
# PBX dialplan conventions (defaults match the Issabel PBX; see docs/rewrite/METRICS.md)
PBX_TRUNK_PEERS=712020159
PBX_SERVICE_NUMBERS=2020159,712020159
PBX_INBOUND_CONTEXTS=ext-queues,from-trunk,ivr-4
PBX_QUEUE_CONTEXTS=ext-queues
PBX_OFF_HOURS_MARKERS=working-time,music-working-time
PBX_EXTENSION_PATTERN=^[0-9]{2,4}$
PBX_DIAL_PREFIXES=0,9
PBX_CDR_HAS_LINKEDID=true
CDR_HISTORY_MAX_DAYS=93
STATS_MAX_DAYS=366

# Working days, hours and holidays: one calendar in the database, edited in Settings (Ish vaqti).
# Operator groups by extension range (until the operator-groups model exists)
OPERATOR_GROUPS=main:100-199;secondary:200-299

# Asterisk AMI (dev: AMI simulator, see infra/dev-pbx)
AMI_HOST=
AMI_PORT=5038
AMI_USER=
AMI_PASSWORD=
# Optional AMI user only for AstDB (blacklist): write=system, no events. Keeps `system` away from the originate user.
AMI_ASTDB_USER=
AMI_ASTDB_PASSWORD=
AMI_PING_INTERVAL_SEC=20
AMI_POLL_INTERVAL_SEC=15
AMI_CHANNEL_TECH=SIP
AMI_DIAL_CONTEXT=from-internal
AMI_QUEUE_MEMBER_INTERFACE=Local/{ext}@from-queue/n
LIVE_OPERATOR_EXTENSION_PATTERN=^[0-9]{2,4}$
# Click-to-call allow-list (regexes over the 9-digit national number); international/premium are rejected by default
ORIGINATE_ALLOWED_PATTERNS=^(33|50|55|77|88|90|91|93|94|95|97|98|99|20|61|62|65|66|67|69|70|71|72|73|74|75|76|78|79)[0-9]{7}$

# Recordings over SFTP (read-only user, key auth)
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PRIVATE_KEY_PATH=
# Folder as the SFTP user sees it: /monitor for the chrooted user (DEPLOY.md 11.3)
SFTP_MONITOR_PATH=/monitor
# Where Asterisk writes recordings (absolute paths in CDR recordingfile)
RECORDINGS_PBX_MONITOR_PATH=/var/spool/asterisk/monitor
# PBX host key pin, REQUIRED in production; comma-separated for rotation:
#   ssh-keyscan -p <port> <host> | ssh-keygen -lf -   → SHA256:...
SFTP_HOST_FINGERPRINT=

# Recordings ZIP export (temp dir defaults to <os tmp>/cc-recording-zips)
RECORDINGS_ZIP_DIR=
RECORDINGS_ZIP_MAX_FILES=2000
RECORDINGS_ZIP_MAX_MB=2048
RECORDINGS_ZIP_TTL_MINUTES=120
RECORDINGS_ZIP_CONCURRENCY=2

# Tickets: attachments directory (outside the web root), upload limit, SLA (working days), recording lookup window
TICKETS_UPLOAD_DIR=.data/ticket-uploads
TICKETS_MAX_FILE_MB=10
TICKETS_SLA_WORKING_DAYS=3
# Callback SLA, working days from done/rejected to closed. TEMPORARY value — the owner has not chosen it yet.
TICKETS_CALLBACK_SLA_WORKING_DAYS=1
TICKETS_RECORDING_LOOKUP_MINUTES=10
# Legacy import only: region code for migrated tickets (they have none); empty = superuser triage
LEGACY_TICKETS_DEFAULT_REGION=

# AI call analysis (docs/rewrite/CALL-ANALYSIS.md). The worker runs elsewhere (AI network) and calls this API.
# CALL_ANALYSIS_ENABLED=true queues new answered calls with a recording automatically (off: superuser backfill only).
CALL_ANALYSIS_ENABLED=false
CALL_ANALYSIS_MIN_TALK_SEC=20
CALL_ANALYSIS_ENQUEUE_INTERVAL_SEC=300
CALL_ANALYSIS_LOOKBACK_HOURS=6
CALL_ANALYSIS_MAX_ATTEMPTS=3
# SHA-256 hex of the worker token (printf %s "$TOKEN" | shasum -a 256); the token itself stays on the worker machine
CALL_ANALYSIS_WORKER_TOKEN_SHA256=

# Callbacks: re-read missed calls from the PBX CDR every N seconds (0 = off) over the last N hours
CALLBACKS_RECONCILE_INTERVAL_SEC=300
CALLBACKS_RECONCILE_LOOKBACK_HOURS=48
# Extensions with a personal AstDB block list blacklist_<ext> in the PBX dialplan
BLACKLIST_OPERATOR_EXTENSIONS=114

# Operator presence log (online / pause time on the KPI page): days to keep, older intervals are deleted nightly
PRESENCE_LOG_RETENTION_DAYS=400

# Tools page: Telegram Form dashboard link (a separate app; empty = "not configured")
TOOLS_TELEGRAM_FORM_URL=
# Read the latest Uzcrypto version from edo.ijro.uz (outbound HTTPS, cached 1 h); false = built-in version
TOOLS_UZCRYPTO_LOOKUP=true
# File converter: timeout per conversion (s), parallel conversions, heap limit per conversion worker (MB)
TOOLS_CONVERT_TIMEOUT_SEC=60
TOOLS_CONVERT_CONCURRENCY=2
TOOLS_CONVERT_MEMORY_MB=512
