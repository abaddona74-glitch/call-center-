{
  "name": "@cc/api",
  "version": "0.0.1",
  "description": "Call center backend (NestJS 12)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/database/migrate.js latest",
    "db:migrate:dev": "nest build && node dist/database/migrate.js latest",
    "db:rollback": "node dist/database/migrate.js down"
  },
  "dependencies": {
    "@cc/shared": "workspace:*",
    "@nestjs-cls/transactional": "^4.0.2",
    "@nestjs-cls/transactional-adapter-kysely": "^2.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-ws": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^12.5.1",
    "@simplewebauthn/server": "^14.1.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "kysely": "^0.29.9",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "mysql2": "^3.24.6",
    "nestjs-cls": "^7.0.2",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
